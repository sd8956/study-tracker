# Copia este archivo a .env.local para desarrollo. En Vercel, configura las mismas variables
# en Project → Settings → Environment Variables. Nunca subas .env.local al repo.

# --- Supabase (Project Settings → API / API Keys) ---
# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: la "anon" (legacy, JWT) o la "publishable" (sb_publishable_...). Es pública por diseño;
# la seguridad la da RLS. NO pongas aquí la service_role / secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Acceso (SOLO servidor, sin prefijo NEXT_PUBLIC_) ---
# Emails permitidos, separados por coma. Fail-closed: vacío o ausente => nadie entra.
ALLOWED_EMAILS=

# --- Cron keepalive (SOLO servidor) ---
# Secreto aleatorio de al menos 16 caracteres (p. ej. `openssl rand -hex 32`).
# Vercel Cron lo envía como `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- URL pública de la app (para el enlace del correo) ---
# Producción: https://<tu-app>.vercel.app   Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE_SERVICE_ROLE_KEY no se usa: la app escribe con la sesión del usuario + RLS.
# Si algún día se añade, debe ser SOLO servidor (sin NEXT_PUBLIC_) y nunca llegar al navegador.
