# Copia este archivo a .env.local. Todo es opcional salvo NAN_API_KEY para el tutor.

# Tutor y voz a texto (NaN Builders). Sin clave, la app oculta el tutor y te autoevalúas.
# Solo servidor: nunca se envía al navegador.
NAN_API_KEY=
# NAN_BASE_URL=https://api.nan.builders/v1
# NAN_CHAT_MODEL=deepseek-v4-flash
# NAN_STT_MODEL=whisper

# Base de datos SQLite (por defecto data/study.db).
# STUDY_DB_PATH=/ruta/a/study.db

# Zona horaria del calendario de estudio (por defecto America/Bogota).
# STUDY_TZ=America/Bogota
